# Server configuration. Copy to .env for local development; never commit real secrets.
PORT=8787
# A contact address or app URL is requested by OpenStreetMap services.
CONTACT_EMAIL=you@example.com
# Optional: a deployed frontend URL when using the server without Vite's development proxy.
ALLOWED_ORIGIN=http://localhost:5173
# Optional: replace public OSRM with a hosted routing service when traffic warrants it.
OSRM_BASE_URL=https://router.project-osrm.org
# Optional: replace public Overpass with a managed endpoint for production traffic.
OVERPASS_URL=https://overpass-api.de/api/interpreter
