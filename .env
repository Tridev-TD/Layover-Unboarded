# Server configuration. Copy to .env for local development; never commit real secrets.
PORT=8787
# A contact address or app URL is requested by OpenStreetMap services.
CONTACT_EMAIL=you@example.com
# Optional: a deployed frontend URL when using the server without Vite's development proxy.
ALLOWED_ORIGIN=http://localhost:5173
# Optional: replace public OSRM with a hosted routing service when traffic warrants it.
OSRM_BASE_URL=https://router.project-osrm.org
# Optional: replace public Overpass with a managed endpoint for production traffic.
OVERPASS_URL=https://overpass-api.de/api/interpreter
# Optional Google provider: requires a Google Cloud project with Places API (New)
# and Geocoding API enabled, plus billing. This key stays on the server.
PLACES_PROVIDER=google
GOOGLE_MAPS_API_KEY=AIzaSyDZ08xgp4ONTHW32ubZu75CMQhiIYLMN_k
# Optional authenticated persistence. Apply database/schema.sql first, then provide
# server-only credentials. Do not expose SUPABASE_SERVICE_ROLE_KEY to the browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
